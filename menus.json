{
  "about": [
    "The keypad's soft menus. 'top' is what the menu key shows; 'menus' holds every other menu by name; 'keys' says what the names in them insert.",
    "A menu is rows of up to five names: the first row is F1-F5, the second shift F1-F5 (drawn above it on the screen); a third and fourth row make a second page (shift up/down turns it). null leaves a slot empty.",
    "A name is, first that applies: another menu (opens it; the menu key goes back up), one of the views vars, catalog, help or setup, abc (a phone's own keyboard), or a key.",
    "A key needs no entry in 'keys' if it's a function: 'factor' alone shows factor and inserts factor(). An entry changes that: label (the text shown) or tex (LaTeX shown instead), insert (what's typed; | is where the cursor goes, around the selection if there's one; one starting with . applies to the last result on an empty line), math (the same for the math input, in LaTeX: #0 is the cursor, #? an empty box; null if it only works as text).",
    "The trig key opens 'trig', shift trig 'hyp', shift = 'test', shift alpha 'chars'.",
    "tools/menus.html edits this file by drag and drop: make serve, then open http://127.0.0.1:8000/tools/menus.html."
  ],

  "top": [
    ["calc", "alg", "num", "matrix", "stat"],
    ["trig", "vars", "catalog", "setup", "help"]
  ],

  "menus": {
    "trig": [
      ["sin", "cos", "tan", "degree", "deg"],
      ["asin", "acos", "atan", "atan2", "trigsimp"]
    ],
    "hyp": [
      ["sinh", "cosh", "tanh", "sec", "csc"],
      ["asinh", "acosh", "atanh", "cot", null]
    ],
    "calc": [
      ["diff", "integrate", "integrate_ab", "limit", "summation"],
      ["series", "product", "dsolve", "iplot", "plot"]
    ],
    "alg": [
      ["solve", "factor", "expand", "simplify", "subs"],
      ["nsolve", "apart", "together", "cancel", "linsolve"]
    ],
    "num": [
      ["abs", "log10", "factorial", "binomial", "mod"],
      ["gcd", "lcm", "floor", "ceiling", "isprime"]
    ],
    "matrix": [
      ["M", "V", "det", "inverse", "transpose"],
      ["eye", "dot", "cross", "eigenvals", "rref"]
    ],
    "stat": [
      ["mean", "median", "stdev", "variance", "sum"],
      ["min", "max", "pstdev", "pvariance", "sorted"]
    ],
    "test": [
      ["<", ">", "<=", ">=", "!="],
      ["==", null, null, null, null]
    ],
    "chars": [
      ["space", "_", "$", ";", "quotes"],
      ["!", "%", "braces", "|", "&"],
      ["quote", "~", "@", "greek", "abc"]
    ],
    "greek": [
      ["theta", "phi", "alpha", "omega", "lamda"],
      ["mu", "sigma", "rho", "delta", "epsilon"],
      ["tau", "psi", "xi", "nu", "eta"]
    ]
  },

  "keys": {
    "degree": { "label": "°", "insert": "°", "math": "\\degree" },
    "asin": { "tex": "\\sin^{-1}", "insert": "asin(|)", "math": "\\arcsin\\left(#0\\right)" },
    "acos": { "tex": "\\cos^{-1}", "insert": "acos(|)", "math": "\\arccos\\left(#0\\right)" },
    "atan": { "tex": "\\tan^{-1}", "insert": "atan(|)", "math": "\\arctan\\left(#0\\right)" },
    "atan2": { "insert": "atan2(|, )", "math": "\\operatorname{atan2}\\left(#0, #?\\right)" },

    "asinh": { "tex": "\\sinh^{-1}" },
    "acosh": { "tex": "\\cosh^{-1}" },
    "atanh": { "tex": "\\tanh^{-1}" },

    "diff": { "tex": "\\frac{d}{dx}", "insert": "diff(|, x)", "math": "\\frac{d}{dx}\\left(#0\\right)" },
    "integrate": { "tex": "\\int", "insert": "integrate(|, x)", "math": "\\int #0\\,dx" },
    "integrate_ab": { "tex": "\\int_a^b", "insert": "integrate(|, (x, 0, 1))", "math": "\\int_{#?}^{#?} #0\\,dx" },
    "limit": { "tex": "\\lim", "insert": "limit(|, x, 0)", "math": "\\lim_{x\\to #?} #0" },
    "summation": { "tex": "\\sum", "insert": "summation(|, (k, 1, n))", "math": "\\sum_{k=#?}^{#?} #0" },
    "series": { "insert": "series(|, x, 0, 6)", "math": "\\operatorname{series}\\left(#0, x, 0, 6\\right)" },
    "product": { "tex": "\\prod", "insert": "product(|, (k, 1, n))", "math": "\\prod_{k=#?}^{#?} #0" },
    "dsolve": { "insert": "dsolve(|, f(x))", "math": null },
    "plot": { "insert": "plot(|, (x, -5, 5))", "math": "\\operatorname{plot}\\left(#0, \\left(x, -5, 5\\right)\\right)" },

    "solve": { "insert": "solve(|, x)", "math": "\\operatorname{solve}\\left(#0, x\\right)" },
    "subs": { "insert": ".subs(x, |)" },
    "nsolve": { "insert": "nsolve(|, x, 1)", "math": "\\operatorname{nsolve}\\left(#0, x, 1\\right)" },
    "linsolve": { "insert": "linsolve([|], [x, y])", "math": null },

    "abs": { "tex": "|x|", "insert": "abs(|)", "math": "\\left|#0\\right|" },
    "log10": { "tex": "\\log_{10}", "insert": "log(|, 10)", "math": "\\log_{10}\\left(#0\\right)" },
    "factorial": { "label": "n!", "insert": "!", "math": "!" },
    "binomial": { "label": "nCr", "insert": "binomial(|, )", "math": "\\binom{#0}{#?}" },
    "mod": { "insert": "Mod(|, )", "math": "\\operatorname{Mod}\\left(#0, #?\\right)" },
    "gcd": { "insert": "gcd(|, )", "math": "\\gcd\\left(#0, #?\\right)" },
    "lcm": { "insert": "lcm(|, )", "math": "\\operatorname{lcm}\\left(#0, #?\\right)" },
    "ceiling": { "label": "ceil" },

    "M": { "label": "M[ ]", "insert": "M[|]", "math": "\\begin{bmatrix}#0 & #?\\\\ #? & #?\\end{bmatrix}" },
    "V": { "label": "V[ ]", "insert": "V[|]", "math": "\\begin{bmatrix}#0\\\\ #?\\end{bmatrix}" },
    "inverse": { "tex": "A^{-1}", "insert": "^-1", "math": "^{-1}" },
    "transpose": { "tex": "A^{T}", "insert": ".T" },
    "dot": { "tex": "u\\cdot v", "insert": ".dot(|)" },
    "cross": { "tex": "u\\times v", "insert": ".cross(|)" },
    "eigenvals": { "label": "eigen", "insert": ".eigenvals()" },
    "rref": { "insert": ".rref()" },

    "<": { "insert": "<" },
    ">": { "insert": ">" },
    "<=": { "tex": "\\le", "insert": "<=", "math": "\\le" },
    ">=": { "tex": "\\ge", "insert": ">=", "math": "\\ge" },
    "!=": { "tex": "\\ne", "insert": "!=", "math": "\\ne" },
    "==": { "insert": "==", "math": null },

    "space": { "label": "␣", "insert": " ", "math": "\\," },
    "_": { "insert": "_", "math": "_{#0}" },
    "$": { "insert": "$", "math": null },
    ";": { "insert": "; ", "math": null },
    "quotes": { "label": "\" \"", "insert": "\"|\"", "math": null },
    "!": { "insert": "!", "math": "!" },
    "%": { "insert": "%", "math": null },
    "braces": { "label": "{ }", "insert": "{|}", "math": null },
    "|": { "insert": "|", "math": null },
    "&": { "insert": "&", "math": null },
    "quote": { "label": "' '", "insert": "'|'", "math": null },
    "~": { "insert": "~", "math": null },
    "@": { "insert": "@", "math": null },

    "theta": { "tex": "\\theta", "insert": "theta", "math": "\\theta" },
    "phi": { "tex": "\\phi", "insert": "phi", "math": "\\phi" },
    "alpha": { "tex": "\\alpha", "insert": "alpha", "math": "\\alpha" },
    "omega": { "tex": "\\omega", "insert": "omega", "math": "\\omega" },
    "lamda": { "tex": "\\lambda", "insert": "lamda", "math": "\\lambda" },
    "mu": { "tex": "\\mu", "insert": "mu", "math": "\\mu" },
    "sigma": { "tex": "\\sigma", "insert": "sigma", "math": "\\sigma" },
    "rho": { "tex": "\\rho", "insert": "rho", "math": "\\rho" },
    "delta": { "tex": "\\delta", "insert": "delta", "math": "\\delta" },
    "epsilon": { "tex": "\\epsilon", "insert": "epsilon", "math": "\\epsilon" },
    "tau": { "tex": "\\tau", "insert": "tau", "math": "\\tau" },
    "psi": { "tex": "\\psi", "insert": "psi", "math": "\\psi" },
    "xi": { "tex": "\\xi", "insert": "xi", "math": "\\xi" },
    "nu": { "tex": "\\nu", "insert": "nu", "math": "\\nu" },
    "eta": { "tex": "\\eta", "insert": "eta", "math": "\\eta" }
  }
}
